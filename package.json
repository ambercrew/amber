{
	"name": "amber",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"android:dev": "tauri android dev --features wry",
		"android:build": "tauri android build --features wry",
		"lint": "eslint .",
		"test": "vitest",
		"uitest": "vitest --ui",
		"coverage": "vitest run --coverage",
		"format": "prettier . --write",
		"prepare": "husky",
		"devtools": "react-devtools",
		"update-npm": "ncu --upgrade --cooldown 14",
		"tauri:windows:build": "set STORE_BUILD=1 && tauri-windows-bundle build",
		"icon": "tauri icon --ios-color '#F5F3EE' ./icon-manifest.json"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md,html}": "prettier --write",
		"*.rs": "cargo fmt --manifest-path ./src-tauri/Cargo.toml --"
	},
